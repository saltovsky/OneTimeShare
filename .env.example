# --- Initial admin credentials (seeded into DB on first boot) ---
# CHANGE THESE BEFORE DEPLOYING.
# After first boot, manage users via the Admin Panel UI (/admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- Initial uploader credentials (seeded into DB on first boot) ---
# Separate from admin so the upload role can be granted without giving
# the ability to manage users or see all files. CHANGE BEFORE DEPLOYING.
UPLOADER_USERNAME=uploader
UPLOADER_PASSWORD=changeme

# --- Cryptographic secret used to sign session and download cookies (must be long & random) ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=please-change-this-to-a-long-random-string

# --- Upload limits (bytes) ---
MAX_FILE_SIZE=104857600            # 100 MB  per file
MAX_TOTAL_SIZE=524288000           # 500 MB  per upload

# --- Background orphan-cleanup task interval (seconds) ---
CLEANUP_INTERVAL_SECONDS=3600

# --- Public URL used when generating share links in the UI ---
APP_URL=http://localhost:8000

# --- Address the container binds on the host (security: localhost-only by default) ---
BIND_ADDR=127.0.0.1

# --- Logging ---
LOG_LEVEL=INFO
